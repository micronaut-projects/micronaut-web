{
  "name": "micronaut-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run typecheck:scripts && npm run style && npm run test:asciidoc && npm run test:docs && npm run test:guides && npm run test:main-site && npm run test:deployment && node scripts/validate-docs-snippet-style-sharing.ts",
    "snippet-styles": "node scripts/validate-docs-snippet-style-sharing.ts",
    "sync:docs-projects": "node scripts/sync-docs-fixture.ts",
    "render:docs": "node scripts/render-docs.ts",
    "fetch:configuration-references": "node scripts/fetch-configuration-references.ts",
    "render:guides": "node scripts/render-guides.ts",
    "prepare:generated-docs": "npm run render:docs",
    "prepare:generated-content": "node scripts/prepare-generated-content.ts",
    "test:main-site": "node --test scripts/tests/main-site/*.test.ts && node scripts/run-browser-tests.ts main",
    "test:main-site:browser": "node scripts/ensure-playwright-chromium.ts && playwright test --config playwright.config.ts tests/playwright/main-site.spec.ts",
    "test:asciidoc": "node --test scripts/tests/asciidoc/*.test.ts",
    "test:docs": "node --test scripts/tests/docs/*.test.ts && node scripts/run-browser-tests.ts docs",
    "test:docs:browser": "node scripts/ensure-playwright-chromium.ts && node tests/playwright/generated-content-fixtures.ts docs && playwright test --config playwright.config.ts tests/playwright/docs.spec.ts",
    "test:guides": "node --test scripts/tests/guides/*.test.ts && node scripts/run-browser-tests.ts guides",
    "test:guides:browser": "node scripts/ensure-playwright-chromium.ts && node tests/playwright/generated-content-fixtures.ts guides && playwright test --config playwright.config.ts tests/playwright/guides.spec.ts",
    "test:deployment": "node --test scripts/tests/deployment/*.test.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit --pretty false",
    "style": "prettier --check \"{scripts,src,tests}/**/*.{ts,tsx,astro}\" astro.config.mjs",
    "style:fix": "prettier --write \"{scripts,src,tests}/**/*.{ts,tsx,astro}\" astro.config.mjs",
    "dev": "npm run check && npm run prepare:generated-content && astro dev --host 127.0.0.1",
    "build:artifact": "npm run prepare:generated-content && astro build && node scripts/build-site-header-shell.ts && node scripts/assert-browser-runtime-assets.ts && node scripts/prepare-template-artifacts.ts",
    "build:site": "npm run check && npm run build:artifact",
    "build": "npm run check && npm run build:artifact",
    "build:surface": "node scripts/build-surface.ts",
    "build:main": "node scripts/build-surface.ts --surface main",
    "build:docs": "node scripts/build-surface.ts --surface docs",
    "build:guides": "node scripts/build-surface.ts --surface guides",
    "audit:lighthouse": "lhci autorun",
    "prune:surface": "node scripts/prune-surface.ts",
    "update:docs-versions": "node scripts/update-docs-version-manifest.ts",
    "publish:docs-surface": "node scripts/publish-docs-surface.ts",
    "publish:docs-snapshot": "node scripts/publish-docs-snapshot.ts",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@asciidoctor/core": "4.0.11",
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "asciidoctor": "4.0.11",
    "astro": "7.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "js-yaml": "^5.3.0",
    "lucide-react": "^1.31.0",
    "parse5": "^8.0.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.3",
    "smol-toml": "^1.8.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "vite": "^8.0.13"
  }
}
