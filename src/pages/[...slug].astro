---
import WebLayout from "@/layouts/WebLayout.astro";
import { Badge } from "@/components/ui/badge";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { FaqAccordion } from "@/components/web/faq-accordion";
import GeneratedDocsStaticEnhancer from "@/components/web/generated-docs-static-enhancer.astro";
import MainSiteMarkdown from "@/components/web/main-site-markdown.astro";
import CommercialSupport from "@/components/web/commercial-support.astro";
import SiteFooter from "@/components/web/site-footer.astro";
import StoryLogo from "@/components/web/story-logo.astro";
import { withBasePath } from "@/lib/base-path";
import {
  getBlogArchiveRoutes,
  getBlogPostByRouteSlug,
  getBlogPosts,
  getBlogPostsForArchive,
  isGeneralBlogPost,
  generatedMainSitePages,
  getMainSitePages,
  getSuccessStories,
  cleanExcerptText,
  normalizeRouteSlug,
  renderFaqItems,
  renderMarkdownHtml,
} from "@/lib/main-site-content";

export async function getStaticPaths() {
  const mainSitePages = await getMainSitePages();
  const pageSlugs = new Set(mainSitePages.map((page) => page.slug));
  const posts = await getBlogPosts();
  const archives = await getBlogArchiveRoutes();
  const pageRedirects = mainSitePages.flatMap((page) =>
    page.entry.data.redirectFrom
      .map((redirectFrom) => normalizeRouteSlug(redirectFrom))
      .filter((redirectSlug) => redirectSlug && !pageSlugs.has(redirectSlug))
      .map((redirectSlug) => ({
        params: { slug: redirectSlug },
        props: { redirectTo: page.slug },
      })),
  );
  return [
    ...generatedMainSitePages.map((generatedPage) => ({
      params: { slug: generatedPage.slug },
      props: { generatedPage },
    })),
    ...mainSitePages.map((page) => ({
      params: { slug: page.slug },
      props: { page },
    })),
    ...pageRedirects,
    ...archives
      .filter((archive) => !pageSlugs.has(archive.slug))
      .map((archive) => ({
        params: { slug: archive.slug },
        props: { archive },
      })),
    ...posts.flatMap((post) =>
      post.routeSlugs
        .filter(
          (routeSlug) =>
            !pageSlugs.has(routeSlug) &&
            !(routeSlug.startsWith("blog/") && routeSlug.endsWith(".html")),
        )
        .map((routeSlug) => ({
          params: { slug: routeSlug },
          props: { post },
        })),
    ),
  ];
}

const { archive, generatedPage, page, post, redirectTo } = Astro.props;
if (redirectTo) {
  return Astro.redirect(withBasePath(`/${redirectTo}/`), 301);
}

const routeSlug =
  page?.slug ?? generatedPage?.slug ?? archive?.slug ?? post.slug;
const relatedPost =
  post ??
  (!archive && !generatedPage
    ? await getBlogPostByRouteSlug(routeSlug)
    : undefined);
const entry = relatedPost?.entry ?? page?.entry;
const pageData =
  page?.entry.data ??
  generatedPage ??
  (archive
    ? {
        title: archive.title,
        eyebrow: archive.eyebrow,
        description: archive.description,
        intro: archive.description,
      }
    : {
        title: relatedPost.entry.data.title,
        eyebrow:
          relatedPost.entry.data.category === "success-story"
            ? "Success story"
            : "Blog",
        description: cleanExcerptText(relatedPost.entry.data.description),
        intro: undefined,
      });
const pageDescription = cleanExcerptText(pageData.description);
const intro = pageData.intro
  ? cleanExcerptText(pageData.intro)
  : relatedPost
    ? undefined
    : pageDescription;
const isSuccessStoriesIndex = routeSlug === "micronaut-success-stories";
const isBlogArchiveRoute =
  routeSlug === "blog" ||
  routeSlug.startsWith("blog/page/") ||
  routeSlug.startsWith("tag/") ||
  routeSlug.startsWith("category/");
const isFaqPage = routeSlug === "faq";
const isCommercialSupportPage = routeSlug === "support";
const isReleaseAnnouncementsArchive =
  routeSlug === "category/release-announcements";
const isReleaseAnnouncementPost =
  post &&
  (post.entry.data.category === "release-announcements" ||
    post.entry.data.categories.includes("release-announcements"));
const isMinimalArchive =
  isReleaseAnnouncementsArchive ||
  routeSlug === "blog" ||
  routeSlug.startsWith("blog/page/") ||
  routeSlug.startsWith("category/");
const usesPublicMarkdownLayout =
  "layoutVariant" in pageData && pageData.layoutVariant === "public-markdown";
const archivePosts = await getBlogPostsForArchive(routeSlug);
const regularBlogPostCount =
  routeSlug === "blog"
    ? (await getBlogPosts()).filter(isGeneralBlogPost).length
    : 0;
const blogArchivePage = archive?.page ?? (routeSlug === "blog" ? 1 : undefined);
const blogArchiveTotalPages =
  archive?.totalPages ??
  (routeSlug === "blog" ? Math.ceil(regularBlogPostCount / 24) : undefined);
const faqItems = entry && isFaqPage ? await renderFaqItems(entry) : [];
// The FAQ page falls back to its own rendered Markdown when no question could be
// extracted; suppressing the body unconditionally rendered an empty page.
const rendersFaqAccordion = isFaqPage && faqItems.length > 0;
const contentHtml =
  entry && !isBlogArchiveRoute && !rendersFaqAccordion
    ? await renderMarkdownHtml(entry)
    : "";
const successStories = await getSuccessStories();
const postDateFormatter = new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
const blogSeries = post
  ? (await getBlogPosts()).filter((candidate) =>
      isReleaseAnnouncementPost
        ? candidate.entry.data.category === "release-announcements" ||
          candidate.entry.data.categories.includes("release-announcements")
        : isGeneralBlogPost(candidate),
    )
  : [];
const blogSeriesIndex = post
  ? blogSeries.findIndex((candidate) => candidate.slug === post.slug)
  : -1;
const newerPost =
  blogSeriesIndex > 0 ? blogSeries[blogSeriesIndex - 1] : undefined;
const olderPost =
  blogSeriesIndex >= 0 ? blogSeries[blogSeriesIndex + 1] : undefined;
---

<WebLayout
  title={`${pageData.title} | Micronaut`}
  description={pageDescription}
  surface="main"
  pageType={relatedPost ? "article" : "website"}
  publishedTime={relatedPost?.entry.data.date?.toISOString()}
>
  {
    isSuccessStoriesIndex ? (
      <main class="bg-background">
        <section class="border-b bg-card">
          <div class="mx-auto max-w-[var(--page-max)] px-5 pb-10 pt-6 sm:px-6 sm:pb-12 sm:pt-7 xl:px-0">
            <div>
              <h1 class="max-w-3xl text-4xl font-bold leading-tight text-foreground md:text-5xl">
                Micronaut success stories
              </h1>
              <p class="mt-5 max-w-3xl text-base leading-8 text-muted-foreground md:text-[1.05rem]">
                Real teams use Micronaut for serverless APIs, Grails migrations,
                workflow orchestration, IoT microservices, event platforms,
                legacy tool upgrades, and SaaS backends.
              </p>
            </div>
          </div>
        </section>

        <section class="border-b">
          <div class="mx-auto grid max-w-[var(--page-max)] gap-6 px-5 py-[var(--section-y)] sm:px-6 xl:px-0">
            <div class="grid gap-4 lg:grid-cols-2">
              {successStories.map((story) => (
                <a
                  href={withBasePath(story.href)}
                  class="group rounded-xl outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                >
                  <Card className="h-full transition group-hover:-translate-y-0.5 group-hover:border-brand/50 group-hover:shadow-md">
                    <CardHeader>
                      <StoryLogo
                        organization={story.organization}
                        logo={story.logo}
                        logoDark={story.logoDark}
                        logoClass={story.logoClass}
                        invertOnDark={story.logoInvertOnDark}
                        size="sm"
                      />
                      <Badge
                        variant="outline"
                        className="absolute right-6 top-6"
                      >
                        {story.tag}
                      </Badge>
                      <CardTitle className="col-span-full text-xl leading-7">
                        {story.scenario}
                      </CardTitle>
                      <CardDescription className="col-span-full text-[0.95rem]">
                        {story.summary}
                      </CardDescription>
                    </CardHeader>
                    <CardContent className="grid gap-4">
                      <div class="grid gap-3 text-sm leading-6">
                        <div>
                          <p class="font-semibold text-foreground">Challenge</p>
                          <p class="mt-1 text-muted-foreground">
                            {story.challenge}
                          </p>
                        </div>
                        <div>
                          <p class="font-semibold text-foreground">
                            Micronaut fit
                          </p>
                          <p class="mt-1 text-muted-foreground">
                            {story.micronautUse}
                          </p>
                        </div>
                        <div>
                          <p class="font-semibold text-foreground">Outcome</p>
                          <p class="mt-1 text-muted-foreground">
                            {story.outcome}
                          </p>
                        </div>
                      </div>
                      <div class="flex flex-wrap gap-2">
                        {story.technologies.map((technology) => (
                          <Badge variant="secondary">{technology}</Badge>
                        ))}
                      </div>
                    </CardContent>
                  </Card>
                </a>
              ))}
            </div>
          </div>
        </section>
      </main>
    ) : (
      <main class="bg-card">
        <article
          class:list={[
            "mx-auto px-5 py-12 sm:px-6 lg:py-16",
            usesPublicMarkdownLayout || isBlogArchiveRoute
              ? "max-w-[var(--page-max)]"
              : "max-w-[780px]",
          ]}
        >
          {(!usesPublicMarkdownLayout || isBlogArchiveRoute) && (
            <header class:list={["pb-8", !isMinimalArchive && "border-b"]}>
              {post ? (
                <a
                  href={withBasePath(
                    isReleaseAnnouncementPost
                      ? "/category/release-announcements/"
                      : "/blog/",
                  )}
                  class="text-sm font-medium text-brand no-underline underline-offset-4 hover:underline"
                >
                  &larr; {isReleaseAnnouncementPost ? "Releases" : "Blog"}
                </a>
              ) : (
                pageData.eyebrow &&
                pageData.eyebrow !== "Blog" && (
                  <Badge variant="secondary">{pageData.eyebrow}</Badge>
                )
              )}
              <h1
                class:list={[
                  "text-3xl font-bold leading-tight text-balance text-foreground md:text-5xl",
                  (post || (pageData.eyebrow && pageData.eyebrow !== "Blog")) &&
                    "mt-5",
                ]}
              >
                {pageData.title}
              </h1>
              {post && (
                <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted-foreground">
                  {post.entry.data.date && (
                    <time datetime={post.entry.data.date.toISOString()}>
                      {postDateFormatter.format(post.entry.data.date)}
                    </time>
                  )}
                </div>
              )}
              {intro && !isMinimalArchive && (
                <p class="mt-5 text-base leading-8 text-muted-foreground md:text-[1.05rem]">
                  {intro}
                </p>
              )}
            </header>
          )}

          {isCommercialSupportPage ? (
            <CommercialSupport />
          ) : rendersFaqAccordion ? (
            <section class="grid gap-8">
              <header class="max-w-3xl">
                {!isFaqPage && (
                  <Badge variant="secondary">{pageData.eyebrow}</Badge>
                )}
                <h1 class="mt-5 text-3xl font-bold leading-tight text-foreground md:text-5xl">
                  {pageData.title}
                </h1>
                {intro && (
                  <p class="mt-5 text-base leading-8 text-muted-foreground md:text-[1.05rem]">
                    {intro}
                  </p>
                )}
              </header>
              <FaqAccordion items={faqItems} client:visible />
            </section>
          ) : (
            <>
              <MainSiteMarkdown
                html={contentHtml}
                variantClass={
                  routeSlug.startsWith("brand-guidelines")
                    ? "main-site-markdown--brand"
                    : undefined
                }
              />
              {contentHtml && <GeneratedDocsStaticEnhancer />}
            </>
          )}

          {post && (newerPost || olderPost) && (
            <nav
              class="mt-10 grid gap-4 border-t pt-8 sm:grid-cols-2"
              aria-label="More from the blog"
            >
              {olderPost ? (
                <a
                  href={withBasePath(olderPost.href)}
                  class="group grid gap-1 rounded-xl border p-4 no-underline transition hover:border-brand/50 hover:shadow-md focus-visible:ring-[3px] focus-visible:ring-ring/50"
                >
                  <span class="text-xs text-muted-foreground">
                    &larr; Older
                  </span>
                  <span class="text-sm font-semibold leading-6 text-foreground group-hover:text-brand">
                    {olderPost.entry.data.title}
                  </span>
                </a>
              ) : (
                <span aria-hidden="true" />
              )}
              {newerPost && (
                <a
                  href={withBasePath(newerPost.href)}
                  class="group grid gap-1 rounded-xl border p-4 text-right no-underline transition hover:border-brand/50 hover:shadow-md focus-visible:ring-[3px] focus-visible:ring-ring/50"
                >
                  <span class="text-xs text-muted-foreground">
                    Newer &rarr;
                  </span>
                  <span class="text-sm font-semibold leading-6 text-foreground group-hover:text-brand">
                    {newerPost.entry.data.title}
                  </span>
                </a>
              )}
            </nav>
          )}

          {archivePosts.length > 0 && (
            <section
              class:list={[
                isMinimalArchive ? "pt-0" : "pt-8",
                contentHtml ? "mt-10 border-t" : "",
              ]}
            >
              {!isMinimalArchive && (
                <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                  <div>
                    <h2 class="text-2xl font-semibold leading-tight text-foreground">
                      {routeSlug === "blog"
                        ? "Latest articles"
                        : "Available articles"}
                    </h2>
                  </div>
                  {routeSlug === "blog" &&
                    blogArchiveTotalPages &&
                    blogArchiveTotalPages > 1 && (
                      <a
                        href={withBasePath("/blog/page/2/")}
                        class="text-sm font-medium text-brand underline-offset-4 hover:underline"
                      >
                        Browse older articles &rarr;
                      </a>
                    )}
                </div>
              )}
              <div
                class:list={[
                  "grid gap-4 lg:grid-cols-2",
                  !isMinimalArchive && "mt-5",
                ]}
              >
                {archivePosts.map((post) => (
                  <a
                    href={withBasePath(post.href)}
                    class="group rounded-xl outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                  >
                    <Card className="h-full transition group-hover:-translate-y-0.5 group-hover:border-brand/50 group-hover:shadow-md">
                      <CardHeader>
                        <div class="col-span-full flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                          {post.entry.data.date && (
                            <span>
                              {postDateFormatter.format(post.entry.data.date)}
                            </span>
                          )}
                        </div>
                        <CardTitle className="col-span-full text-xl leading-7">
                          {post.entry.data.title}
                        </CardTitle>
                        <CardDescription className="col-span-full line-clamp-3">
                          {cleanExcerptText(post.entry.data.description)}
                        </CardDescription>
                      </CardHeader>
                    </Card>
                  </a>
                ))}
              </div>
              {blogArchivePage &&
                blogArchiveTotalPages &&
                blogArchiveTotalPages > 1 && (
                  <nav
                    class="mt-6 flex flex-wrap items-center justify-between gap-3 text-sm"
                    aria-label="Blog archive pagination"
                  >
                    {blogArchivePage > 2 ? (
                      <a
                        href={withBasePath(
                          `/blog/page/${blogArchivePage - 1}/`,
                        )}
                        class="font-medium text-brand underline-offset-4 hover:underline"
                      >
                        &larr; Previous
                      </a>
                    ) : blogArchivePage > 1 ? (
                      <a
                        href={withBasePath("/blog/")}
                        class="font-medium text-brand underline-offset-4 hover:underline"
                      >
                        &larr; Previous
                      </a>
                    ) : (
                      <span />
                    )}
                    <span class="text-muted-foreground">
                      Page {blogArchivePage} of {blogArchiveTotalPages}
                    </span>
                    {blogArchivePage < blogArchiveTotalPages && (
                      <a
                        href={withBasePath(
                          `/blog/page/${blogArchivePage + 1}/`,
                        )}
                        class="font-medium text-brand underline-offset-4 hover:underline"
                      >
                        Next &rarr;
                      </a>
                    )}
                  </nav>
                )}
            </section>
          )}
        </article>
      </main>
    )
  }
  <SiteFooter />
</WebLayout>
