---
import { readFile } from "node:fs/promises";
import { join } from "node:path";

import WebLayout from "@/layouts/WebLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Separator } from "@/components/ui/separator";
import DocsRelatedGuides from "@/components/web/docs-related-guides.astro";
import DocsShell from "@/components/web/docs-shell.astro";
import GeneratedDocsStaticEnhancer from "@/components/web/generated-docs-static-enhancer.astro";
import { IconBadge } from "@/components/web/icon-badge";
import { ProjectReferenceLinks } from "@/components/web/project-reference-links";
import {
  canonicalSurfaceUrl,
  withBasePath,
  withSurfacePath,
} from "@/lib/base-path";
import {
  docsCatalogProject,
  loadDocsProjectCatalog,
} from "@/lib/docs-project-catalog";
import {
  enhanceGeneratedContentHtml,
  extractGeneratedDocSections,
} from "@/lib/generated-docs-html";
import { shouldBuildDocsRoutes } from "@/lib/surface-routes";
import { readConfigurationReferences } from "../../../scripts/docs/configuration-references-store.ts";
import { projectReferenceLinks } from "../../../scripts/docs/search-index.ts";
import "@/styles/generated-docs-content.css";

export async function getStaticPaths() {
  if (!shouldBuildDocsRoutes()) {
    return [];
  }
  const docsProjectCatalog = await loadDocsProjectCatalog();
  return docsProjectCatalog.projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const docsProjectCatalog = await loadDocsProjectCatalog();
const project = docsCatalogProject(docsProjectCatalog, Astro.params.slug!);
if (!project) {
  return Astro.redirect(withBasePath("/docs/"));
}

/**
 * Built here, not in the template: `<pre>` preserves whitespace, so any
 * reflow of the markup would render the indentation as part of the snippet.
 */
const projectCoordinatesHtml = `<code>${[
  `micronaut.project=${project.slug}`,
  `micronaut.module=${project.module}`,
  `micronaut.category=${project.primaryCategory}`,
]
  .join("\n")
  .replaceAll("&", "&amp;")
  .replaceAll("<", "&lt;")
  .replaceAll(">", "&gt;")}</code>`;

let generatedDocHtml: string | undefined;
try {
  generatedDocHtml = await readFile(
    join(
      process.cwd(),
      "src",
      "content",
      "generated-docs",
      `${project.slug}.html`,
    ),
    "utf8",
  );
  generatedDocHtml = enhanceGeneratedContentHtml(generatedDocHtml);
} catch {
  generatedDocHtml = undefined;
}

/**
 * Sections split out of this guide into another project (Core's HTTP chapters)
 * are still linked here by their old bare ids, so the page names where each
 * one went and the hash aligner forwards the reader.
 */
const movedSections = await Promise.all(
  docsProjectCatalog.projects
    .filter((candidate) => candidate.derivedFrom === project.slug)
    .map(async (derived) => ({
      href: withBasePath(`/docs/${derived.slug}/`),
      ids: extractGeneratedDocSections(
        await readFile(
          join(
            process.cwd(),
            "src",
            "content",
            "generated-docs",
            `${derived.slug}.html`,
          ),
          "utf8",
        ).catch(() => ""),
      ).map((section) => section.id.replace(`${derived.slug}-`, "")),
    })),
);

const canonicalUrl = canonicalSurfaceUrl("docs", `/docs/${project.slug}/`);
const generatedDocSections = generatedDocHtml
  ? extractGeneratedDocSections(generatedDocHtml)
  : [];
const contentSections = generatedDocSections.length
  ? generatedDocSections
  : project.sections.map((section) => ({
      id: section.id,
      label: `${section.number}. ${section.title}`,
      depth: 1,
      parentId: undefined,
    }));
const activeProjectSections = contentSections.filter(
  (section) => section.depth === 1,
);
const currentSectionLinks = contentSections.filter(
  (section) => section.depth > 1 && section.parentId,
);
const initialRootId =
  activeProjectSections[0]?.id || currentSectionLinks[0]?.parentId;
const initialCurrentSectionIndexHidden =
  !initialRootId ||
  currentSectionLinks.every((section) => section.parentId !== initialRootId);
const relatedGuideTopicAliases = project.guideTopicAliases || [];
const shouldRenderRelatedGuides = relatedGuideTopicAliases.length > 0;
const guidesManifestUrl = withSurfacePath("guides", "/guides/manifest.json");
const configurationReferences = await readConfigurationReferences();
const referenceLinks = projectReferenceLinks(project, {
  localConfigurationReference: Boolean(configurationReferences[project.slug]),
}).map((reference) => ({
  ...reference,
  external: /^https?:/.test(reference.href),
  href: /^https?:/.test(reference.href)
    ? reference.href
    : withBasePath(reference.href),
}));
---

<WebLayout
  title={`${project.shortName} Docs`}
  description={project.longDescription}
  surface="docs"
  canonicalUrl={canonicalUrl}
>
  <DocsShell
    projectCatalog={docsProjectCatalog}
    activeSlug={project.slug}
    activeSections={activeProjectSections}
    currentSections={currentSectionLinks}
    initialRootId={initialRootId}
  >
    <article
      class:list={[
        "grid w-full grid-cols-1 py-6",
        generatedDocHtml
          ? "px-4 md:px-12 xl:grid-cols-[minmax(0,1fr)_260px] xl:gap-8"
          : "px-4 md:px-5 xl:grid-cols-[minmax(0,1fr)_240px] xl:px-0",
      ]}
    >
      <div class:list={["min-w-0", !generatedDocHtml && "xl:px-14"]}>
        {
          /* The references sit where the reader starts, at the top of the
             page, and from sm up they ride the scroll pinned under the
             topbar, so every chapter is one click from the API and
             configuration references. Phones keep the row in flow: pinned,
             the pair wraps and would cover the prose it sits over. The
             version rides along at the row's other end: which release of the
             module a page documents was written down nowhere on it, and a
             reader deep in a chapter needs it as much as one at the top. */
        }
        <div
          data-docs-reference-links
          class="group/references z-30 mb-6 flex flex-wrap items-center gap-2 sm:sticky sm:top-[calc(var(--topbar-height)+16px)] sm:mb-4"
        >
          {
            project.version && (
              <span
                data-docs-project-version
                class="mr-auto rounded-md border bg-background px-2.5 py-1 text-xs font-medium text-muted-foreground transition-shadow duration-300 ease-out group-data-[stuck=true]/references:shadow-md"
              >
                {project.shortName} {project.version}
              </span>
            )
          }
          <nav
            aria-label="Reference documentation"
            class="flex flex-wrap gap-2 sm:justify-end"
          >
            {
              referenceLinks.map((reference) => (
                <a
                  href={reference.href}
                  target={reference.external ? "_blank" : undefined}
                  rel={reference.external ? "noreferrer" : undefined}
                  class:list={[
                    buttonVariants({ size: "sm", variant: "outline" }),
                    "transition-shadow duration-300 ease-out group-data-[stuck=true]/references:shadow-md",
                  ]}
                >
                  {reference.label}
                </a>
              ))
            }
          </nav>
        </div>
        {
          !generatedDocHtml && (
            <header id={`${project.slug}-docs`} class="mb-7 scroll-mt-24">
              <div class="flex items-center gap-3">
                <IconBadge
                  name={project.icon}
                  size="lg"
                  themeTreatment={project.iconThemeTreatment || "auto"}
                />
                <h1 class="text-3xl font-bold tracking-tight md:text-4xl">
                  {project.shortName}
                </h1>
              </div>
              <p class="mt-3 max-w-2xl text-base leading-7 text-muted-foreground">
                {project.longDescription}
              </p>
              <ProjectReferenceLinks references={project.references} />
            </header>
          )
        }
        {
          /* The sidebar rails are xl-only, so below that this disclosure is
             the page's whole outline — every chapter with its subsections,
             not just the first chapter's. */
          currentSectionLinks.length > 0 && (
            <details class="mb-6 rounded-lg border px-4 py-3 xl:hidden">
              <summary class="cursor-pointer text-sm font-medium">
                On this page
              </summary>
              <nav aria-label="On this page">
                <ul class="mt-3 grid gap-0.5 text-sm">
                  {contentSections.map((section) => (
                    <li>
                      <a
                        href={`#${section.id}`}
                        class:list={[
                          "block rounded-md px-2 py-1 no-underline hover:bg-accent hover:text-foreground",
                          section.depth === 1
                            ? "font-medium"
                            : "text-muted-foreground",
                          section.depth > 1 && section.indent <= 2 && "pl-4",
                          section.indent === 3 && "pl-7",
                          section.indent >= 4 && "pl-10",
                        ]}
                      >
                        {section.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          )
        }
        {
          /* Ahead of the chapter, in the content column: collapsed it is one
             disclosure row, and the side rail is too narrow for the card grid
             while the end of these very long chapters is never reached. */
          shouldRenderRelatedGuides && (
            <aside aria-label="Latest guides">
              <DocsRelatedGuides
                manifestUrl={guidesManifestUrl}
                topicAliases={relatedGuideTopicAliases}
              />
            </aside>
          )
        }
        {
          generatedDocHtml ? (
            <>
              <div
                class="generated-docs-content"
                data-generated-docs={project.slug}
                data-generated-docs-moved={
                  movedSections.length
                    ? JSON.stringify(movedSections)
                    : undefined
                }
                set:html={generatedDocHtml}
              />
              <GeneratedDocsStaticEnhancer />
            </>
          ) : (
            <>
              <div class="grid gap-8 text-base leading-7">
                {project.sections.map((section) => (
                  <section id={section.id} class="scroll-mt-24">
                    <h2 class="text-2xl font-semibold tracking-tight">
                      {section.number}. {section.title}
                    </h2>
                    <p class="mt-3 max-w-3xl text-muted-foreground">
                      {section.summary}
                    </p>
                    <Card className="mt-4">
                      <CardHeader>
                        <CardTitle className="text-base">
                          {section.title}
                        </CardTitle>
                        <CardDescription>
                          {project.displayName} reference entry.
                        </CardDescription>
                      </CardHeader>
                      <CardContent>
                        <p>
                          This lightweight docs page is ready for generated
                          module documentation, API references, configuration
                          pages, and search entries while preserving the shared
                          Micronaut web styling.
                        </p>
                        <div class="mt-4 overflow-hidden rounded-lg border bg-muted/50">
                          <pre
                            class="overflow-x-auto p-4 text-sm leading-7"
                            set:html={projectCoordinatesHtml}
                          />
                        </div>
                      </CardContent>
                    </Card>
                  </section>
                ))}
              </div>
            </>
          )
        }
        {
          /* The pinned row is sm-and-up only, so after a long chapter a
             phone reader gets the references again without scrolling back. */
        }
        <nav
          aria-label="Reference documentation"
          class="mt-8 flex flex-wrap gap-2 sm:hidden"
        >
          {
            referenceLinks.map((reference) => (
              <a
                href={reference.href}
                target={reference.external ? "_blank" : undefined}
                rel={reference.external ? "noreferrer" : undefined}
                class:list={buttonVariants({ size: "sm", variant: "outline" })}
              >
                {reference.label}
              </a>
            ))
          }
        </nav>
      </div>
      {
        /* One grid child, so both rails stay in the side column: a second
          top-level child would auto-place into the content column's next row
          and overlap the prose. The wrapper is the stretched grid item, so the
          rail inside it has to claim that height too: sticky can only travel
          inside its own containing block, and an auto-height <aside> gives it
          nowhere to go. */
      }
      <div class="min-w-0">
        {
          currentSectionLinks.length > 0 && (
            <aside
              class="hidden h-full xl:block"
              aria-label="In this section"
              data-docs-current-section-index
              hidden={initialCurrentSectionIndexHidden}
            >
              <div
                class="sticky top-[calc(var(--topbar-height)+24px)] grid max-h-[calc(100vh-var(--topbar-height)-48px)] gap-1.5 overflow-y-auto pb-7 pl-2.5 pr-6 text-[0.82rem] [scrollbar-width:thin]"
                data-docs-scroll-container
              >
                <h2 class="font-medium">In this section</h2>
                <Separator className="opacity-70" />
                {currentSectionLinks.map((section) => (
                  <a
                    href={`#${section.id}`}
                    data-docs-current-section-link
                    data-docs-scroll-link
                    data-docs-section-root-id={section.parentId}
                    hidden={section.parentId !== initialRootId}
                    class:list={[
                      "relative rounded-md py-1.5 pr-2 leading-5 break-words text-muted-foreground no-underline hover:bg-accent hover:text-accent-foreground data-[active=true]:bg-accent data-[active=true]:font-medium data-[active=true]:text-foreground [&.active]:bg-accent [&.active]:font-medium [&.active]:text-foreground",
                      section.indent <= 2 && "pl-2 text-[0.8rem]",
                      section.indent === 3 && "pl-4 text-[0.78rem]",
                      section.indent >= 4 && "pl-6 text-[0.76rem]",
                    ]}
                  >
                    {section.label}
                  </a>
                ))}
              </div>
            </aside>
          )
        }
      </div>
    </article>
  </DocsShell>
</WebLayout>

{
  generatedDocHtml && (
    <script>import "@/scripts/generated-docs-hash-aligner";</script>
  )
}
