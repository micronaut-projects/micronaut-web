<!-- Global because the marks are injected with set:html and so never get
  Astro's scoping attribute. Every selector is nested under .sally-visor. -->
<style is:global>
  /* Starfield across Sally's visor. Travel is linear so the marks never appear
     to slow; depth comes from per-mark speed, bow and swell.

     Speed and phase differ per mark, so they are literal values on each
     mark's own style attribute; only what every mark shares lives here. They
     are written out rather than derived with calc(var(...)), and the vertical
     bow is baked into one keyframe set per track instead of read from a custom
     property: Safari drops an animation shorthand whose duration is a calc()
     of a variable, and is unreliable about var() inside @keyframes, so either
     would leave the marks parked outside the visor and invisible. */
  @keyframes sallyStreakA {
    0%,
    0% {
      transform: translate(0, 0) scale(0.5);
      opacity: 0;
    }
    14% {
      opacity: 0.85;
    }
    50% {
      transform: translate(-214px, -15px) scale(1.16);
      opacity: 1;
    }
    86% {
      opacity: 0.5;
    }
    100% {
      transform: translate(-428px, 0) scale(0.5);
      opacity: 0;
    }
  }
  @keyframes sallyStreakB {
    0%,
    0% {
      transform: translate(0, 0) scale(0.5);
      opacity: 0;
    }
    14% {
      opacity: 0.85;
    }
    50% {
      transform: translate(-214px, -8px) scale(1.16);
      opacity: 1;
    }
    86% {
      opacity: 0.5;
    }
    100% {
      transform: translate(-428px, 0) scale(0.5);
      opacity: 0;
    }
  }
  @keyframes sallyStreakC {
    0%,
