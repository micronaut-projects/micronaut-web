);
const release = await latestMicronautRelease();
// Sheen sweeping across the visor: a band bowed onto the visor's curve rather
// than a straight bar laid over it. Its soft edges are stacked strokes of
// shrinking width, because a linear gradient can only fade sideways across a
// straight shape; each stroke adds the alpha the wider one beneath it is still
// missing, so the stack composites into a gaussian falloff.
const sheenReach = 34;
const sheenSteps = 14;
const sheenFalloff = (distance: number) =>
  0.66 * Math.exp(-((distance / 14) ** 2));
const sallyVisorSheen = Array.from({ length: sheenSteps }, (_, index) => {
  const step = sheenReach / sheenSteps;
  const radius = (sheenSteps - index) * step;
  const opacity =
    1 - (1 - sheenFalloff(radius)) / (1 - sheenFalloff(radius + step));
  return `<path d="M0,-172 C48,-82 48,78 0,168" stroke-width="${(radius * 2).toFixed(1)}" stroke-opacity="${opacity.toFixed(4)}"/>`;
}).join("");
// Starfield drifting across Sally's visor, clipped to the visor path. The
// marks are dealt by a seeded generator rather than written out by hand, so
// nothing about the scatter repeats on a beat the eye can pick up: position,
// size, colour, speed, phase and bow are all drawn per mark. The seed keeps
// every build identical; change it to deal a different sky.
let starSeed = 0x5a11e5;
const starRandom = () => {
  starSeed = (starSeed + 0x6d2b79f5) | 0;
  let t = Math.imul(starSeed ^ (starSeed >>> 15), 1 | starSeed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const between = (low: number, high: number) =>
  low + starRandom() * (high - low);
function pick<T>(items: T[]): T {
  return items[Math.floor(starRandom() * items.length)];
}
// Star colours, loosely by spectral flavour: a soft outer glow, the body of
// the mark, and a hotter near-white centre. Weights keep the sky mostly blue
// and white, with the warm tints common enough to notice and the odd cyan or
// lilac rare enough to feel like a find.
const starTints = [
  { weight: 5, glow: "#8fb6ef", body: "#bcd8ff", core: "#f2f8ff" },
  { weight: 5, glow: "#9fc4ff", body: "#dbeaff", core: "#ffffff" },
  { weight: 4, glow: "#cfe3ff", body: "#eaf4ff", core: "#ffffff" },
  { weight: 4, glow: "#ffe6a4", body: "#fff6d6", core: "#ffffff" },
  { weight: 3, glow: "#ffd68f", body: "#fff2e0", core: "#fffaf0" },
  { weight: 3, glow: "#ffcf5f", body: "#ffe6a4", core: "#fff8e2" },
  { weight: 2, glow: "#ffb473", body: "#ffd3a6", core: "#fff1e0" },
  { weight: 2, glow: "#ff9d8f", body: "#ffc2b6", core: "#ffece7" },
  { weight: 1, glow: "#7fd8d4", body: "#b7f0ee", core: "#eafffe" },
  { weight: 1, glow: "#b39cff", body: "#d9c8ff", core: "#f3ecff" },
];
const starTintPool = starTints.flatMap((tint) =>
  Array.from({ length: tint.weight }, () => tint),
);
// Depth reads off speed and size together: the far layer is small, dim and
// slow, the near layer large, bright and quick. The leads are the rare slow
// bright ones that cross on their own schedule.
const starLayers = [
  {
    cls: "sv-far",
    count: 11,
    bright: false,
    radius: [0.9, 1.7],
    duration: [16.8, 23.2],
    opacity: [0.3, 0.5],
  },
  {
    cls: "sv-mid",
    count: 6,
    bright: false,
    radius: [1.7, 2.5],
    duration: [12.4, 16.8],
    opacity: [0.62, 0.86],
  },
  {
    cls: "sv-near",
    count: 3,
    bright: true,
    radius: [2.5, 3.4],
    duration: [8.4, 11.6],
    opacity: [1, 1],
  },
  {
    cls: "sv-lead",
    count: 2,
    bright: true,
    radius: [2.6, 5.2],
    duration: [36, 64],
    opacity: [1, 1],
  },
];
const starSpike =
  "M0,-9 C1.6,-2.4 2.4,-1.6 9,0 C2.4,1.6 1.6,2.4 0,9 C-1.6,2.4 -2.4,1.6 -9,0 C-2.4,-1.6 -1.6,-2.4 0,-9 Z";
// One full pass, matching the keyframes' 100% translate.
const starTravel = 428;
const starMarks = starLayers.flatMap((layer) =>
  Array.from({ length: layer.count }, () => layer),
);
for (let i = starMarks.length - 1; i > 0; i--) {
  const j = Math.floor(starRandom() * (i + 1));
  [starMarks[i], starMarks[j]] = [starMarks[j], starMarks[i]];
}
// Marks are dealt one per band down the glass and then jittered past their
// band's edges: pure uniform placement clumps and leaves bald patches at this
// count, while a strict ladder reads as a grid. Overlapping the jitter keeps
// the whole height covered and still lets pairs crowd together.
const glassTop = 172;
const glassBand = (324 - glassTop) / starMarks.length;
const sallyVisorField = starMarks
  .map((layer, index) => {
    const y = Math.round(
      Math.min(
        324,
        Math.max(
          glassTop,
          glassTop + (index + between(-0.35, 1.35)) * glassBand,
        ),
      ),
    );
    const radius = between(layer.radius[0], layer.radius[1]);
    const duration = between(layer.duration[0], layer.duration[1]);
    const twinkle = between(1.5, 2.7);
    const tint = pick(starTintPool);
    // Where the mark sits in the settled field, as a fraction of its pass.
    // The page opens on clear glass and the stars arrive afterwards, so the
    // delay is what is left of the pass rather than what is behind it: the
    // mark waits off the glass and drifts on to reach that point. The waits
    // run the length of a pass, so marks trickle in over the first crossing
    // rather than sweeping on as a front, and the field is settled once every
    // layer has gone round once. It is also the still position Reduce Motion
    // falls back to.
    const phase = starRandom();
    const body = layer.bright
      ? `<circle r="${(radius * 2.4).toFixed(1)}" fill="${tint.glow}" opacity=".14"/>` +
        `<path d="${starSpike}" transform="scale(${(radius * 0.41).toFixed(2)})" fill="${tint.body}" opacity=".9"/>` +
        `<path d="${starSpike}" transform="rotate(45) scale(${(radius * 0.19).toFixed(2)})" fill="${tint.core}" opacity=".75"/>` +
        `<circle r="${radius.toFixed(1)}" fill="${tint.core}"/>`
      : `<circle r="${radius.toFixed(1)}" fill="${tint.body}" opacity="${between(layer.opacity[0], layer.opacity[1]).toFixed(2)}"/>`;
    // Timings ride on the mark's own style attribute as plain literals, so
    // Safari never sees a duration built from calc(var(...)). The still
    // transform sits there too rather than in a rule per mark: an animation
    // outranks an inline declaration, whether it is running or filling
    // backwards through its delay, so the pinned position surfaces only once
    // Reduce Motion has switched the animation off.
    const motion =
      `animation-duration:${duration.toFixed(2)}s;` +
      `animation-delay:${(duration * (1 - phase)).toFixed(2)}s;` +
      `transform:translate(${(-starTravel * phase).toFixed(0)}px,0) scale(1)`;
    // A lead now and then crosses on the long pass instead of drifting, so it
    // hangs off the glass and then streaks over it.
    const track =
      layer.cls === "sv-lead" && starRandom() < 0.4
        ? "sv-pass"
        : `sv-bow-${pick(["a", "b", "c", "d", "e"])}`;
    return (
      `<g transform="translate(600 ${y})"><g class="sv-m ${layer.cls} ${track}" style="${motion}">` +
      `<g class="sv-tw" style="animation-duration:${twinkle.toFixed(2)}s;animation-delay:-${(twinkle * starRandom()).toFixed(2)}s">` +
      `${body}</g></g></g>`
    );
  })
  .join("");
---

<WebLayout
  title="Micronaut Framework"
  description="A modern, JVM-based, full-stack framework for building modular, easily testable microservice and serverless applications"
  surface="main"
>
  <main>
    <section class="border-b bg-background">
      <div
        class="mx-auto grid max-w-[var(--page-max)] gap-12 px-5 py-[var(--hero-y)] sm:px-6 lg:grid-cols-[minmax(0,1fr)_420px] lg:items-center xl:px-0"
      >
        <div class="max-w-[680px]">
          <h1
            class="max-w-[680px] text-[2rem] font-extrabold leading-[1.1] text-foreground sm:text-[2.5rem] sm:leading-[1.06] md:text-[3.4rem]"
          >
            A modern, JVM&#8209;based framework for fast cloud applications
          </h1>
          <p
            class="mt-5 max-w-[620px] text-[1.05rem] leading-8 text-muted-foreground md:text-[1.1rem]"
          >
            Build modular microservices and serverless applications with
            compile-time dependency injection, fast startup, low memory
            overhead, and GraalVM Native Image support.
          </p>
          <div class="mt-6 flex flex-wrap gap-2.5">
            <Badge variant="outline" className="bg-card px-3 py-1.5 text-xs"
              >Compile-time DI</Badge
            >
            <Badge variant="outline" className="bg-card px-3 py-1.5 text-xs"
              >No runtime reflection</Badge
            >
            <Badge variant="outline" className="bg-card px-3 py-1.5 text-xs"
              >GraalVM native ready</Badge
            >
          </div>
          <div class="mt-7 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap">
            <ActionLink
              href="/docs/"
              label="View documentation"
              size="lg"
              className="col-span-2 sm:col-span-1"
            />
            <ActionLink
              href="https://launch.micronaut.io"
              label="Launch a project"
              size="lg"
              variant="outline"
            />
            <ActionLink
              href="/guides/"
              label="Browse guides"
              size="lg"
              variant="outline"
            />
          </div>
        </div>

        <div class="relative mt-14 lg:mt-0">
          {
            /* Sally stays a plain image; the starfield is a separate overlay
          because CSS animation does not run inside an <img>. */
          }
          <div
            class="absolute -top-12 right-0 z-10 h-24 w-24 drop-shadow-md sm:-top-16 sm:right-5 sm:h-28 sm:w-28 md:h-32 md:w-32"
          >
            <img
              src={withBasePath("/micronaut-assets/icons/micronaut-sally.svg")}
              width="750"
              height="750"
              alt="Sally, the Micronaut mascot"
              class="absolute inset-0 size-full"
            />
            <svg
              viewBox="0 0 750 750"
              aria-hidden="true"
              class="sally-visor absolute inset-0 size-full"
            >
              <defs>
                <clipPath id="sallyVisorClip"
                  ><path
                    d="M525.306,166.792c4.034,25.236,1.191,81.6-36.917,114.759-43.7,38.021-103.88,49.291-157.583,13.14-32.777-22.067-57.369-77.789-25.789-108.671s87.361-28.072,135.746-34.537c51.765-6.917,81.425-4.249,84.543,15.309"
                  ></path></clipPath
                >
              </defs>
              <g clip-path="url(#sallyVisorClip)" set:html={sallyVisorField} />
              <g clip-path="url(#sallyVisorClip)">
                {
                  /* Centred on the visor so the sheen's own rotation and swell
                pivot about the dome rather than the SVG origin, and left
                unrotated so the sweep itself travels straight across. */
                }
                <g transform="translate(404 226)">
                  <g
                    class="sv-glint"
                    fill="none"
                    stroke="#fff"
                    stroke-linecap="round"
                    set:html={sallyVisorSheen}
                  />
                </g>
              </g>
            </svg>
          </div>
          <div
            class="overflow-hidden rounded-xl border border-brand-border bg-card shadow-lg shadow-brand/5"
          >
            <div class="flex items-center gap-3 border-b bg-muted/60 px-5 py-3">
              <div class="flex gap-1.5" aria-hidden="true">
                <span class="size-2.5 rounded-full bg-border"></span>
                <span class="size-2.5 rounded-full bg-border"></span>
                <span class="size-2.5 rounded-full bg-border"></span>
              </div>
              <span class="font-mono text-xs text-muted-foreground"
                >Your first Micronaut app</span
              >
            </div>
            <div class="grid gap-1 px-5 py-5 font-mono text-[0.8rem] leading-6">
              <p>
                <span class="select-none text-brand">$ </span>sdk install
                micronaut
              </p>
              <p>
                <span class="select-none text-brand">$ </span>mn create-app
                com.example.demo
              </p>
              <p class="text-muted-foreground">Application created at ./demo</p>
              <p class="mt-3">
                <span class="select-none text-brand">$ </span>cd demo &&
                ./gradlew run
              </p>
              <p class="text-muted-foreground">
                Startup completed in <span class="text-foreground">235ms</span>.
                Server Running: <span class="text-foreground"
                  >http://localhost:8080</span
                >
              </p>
              <p class="mt-3">
                <span class="select-none text-brand">$ </span>./gradlew
                nativeRun
              </p>
              <p class="text-muted-foreground">
                Startup completed in <span class="text-foreground">15ms</span>.
                Server Running: <span class="text-foreground"
                  >http://localhost:8080</span
                >
              </p>
            </div>
            <div
              class="grid gap-2 border-t bg-muted/40 px-5 py-3 sm:flex sm:flex-wrap sm:items-center sm:justify-between sm:gap-x-3 sm:gap-y-2"
            >
              {
                release ? (
                  <a
                    href={release.releaseNotesUrl}
                    data-micronaut-release-notes
                    target="_blank"
                    rel="noreferrer"
                    class="text-sm font-medium text-muted-foreground transition hover:text-brand"
                  >
                    <span
                      data-micronaut-release-version="Latest release: Micronaut {version}"
                      aria-live="polite"
                    >
                      Latest release: Micronaut {release.version}
                    </span>
                  </a>
                ) : (
                  <a
                    href={withBasePath("/download/")}
                    class="text-sm font-medium text-muted-foreground transition hover:text-brand"
                  >
                    <span
                      data-micronaut-release-version="Latest release: Micronaut {version}"
                      aria-live="polite"
                    >
                      Latest release
                    </span>
                  </a>
                )
              }
              <ActionLink
                href="/cli/"
                label="Download the CLI"
                variant="ghost"
                arrow
                className="h-9 w-full justify-center border border-brand-border text-brand hover:bg-brand-soft hover:text-brand sm:-mr-2 sm:h-8 sm:w-auto sm:border-0"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="border-b bg-muted/40">
      <div
        class="mx-auto grid max-w-[var(--page-max)] gap-7 px-5 py-[var(--section-y)] sm:px-6 xl:px-0"
      >
        <div
          class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between"
        >
          <div class="min-w-0">
            <h2 class="max-w-[480px] text-3xl font-bold md:text-4xl">
              Built around Micronaut's strongest differentiators
            </h2>
          </div>
          <p class="max-w-[560px] text-base leading-7 text-muted-foreground">
            Compile-time APIs, native-image readiness, integrated testing, cloud
            support, and productive data access work together instead of
            competing for attention.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            features.map((feature) => (
