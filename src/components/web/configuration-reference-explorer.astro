---
import { Separator } from "@/components/ui/separator";

/**
 * The shared body of the configuration reference pages: header, sticky
 * filter, grouped property tables, and a sticky rail listing the groups.
 * The unified page groups by module; a module's own page groups by section.
 */
export interface ReferenceRow {
  property: string;
  type: string;
  typeHref?: string;
  description: string;
  defaultValue: string;
}

export interface ReferenceTable {
  id?: string;
  owner?: string;
  ownerHref?: string;
  rows: ReferenceRow[];
}

export interface ReferenceGroup {
  id: string;
  heading: string;
  headingHref?: string;
  tables: ReferenceTable[];
}

interface Props {
  pageTitle: string;
  intro: string;
  headerLink?: { label: string; href: string };
  railLabel: string;
  groupNoun: string;
  groups: ReferenceGroup[];
}

const { pageTitle, intro, headerLink, railLabel, groupNoun, groups } =
  Astro.props;

const groupCount = (group: ReferenceGroup) =>
  group.tables.reduce((total, table) => total + table.rows.length, 0);
const propertyCount = groups.reduce(
  (total, group) => total + groupCount(group),
  0,
);
const countLabel = `${propertyCount} properties across ${groups.length} ${
  groups.length === 1 ? groupNoun.replace(/s$/, "") : groupNoun
}`;
---

<article
  class="mx-auto grid w-full max-w-[1346px] grid-cols-1 gap-8 px-5 py-7 md:px-6 xl:grid-cols-[minmax(0,1fr)_240px]"
  data-docs-configuration-reference
>
  <div class="grid min-w-0 gap-6">
    <header>
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">
        {pageTitle}
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-7 text-muted-foreground">
        {intro}
      </p>
      {
        headerLink && (
          <p class="mt-2 text-sm">
            <a
              href={headerLink.href}
              class="text-brand no-underline hover:underline"
            >
              {headerLink.label}
            </a>
          </p>
        )
      }
    </header>
    {
      /* Sticky below the topbar (and the mobile docs-nav bar) so the filter
         stays at hand while scrolling hundreds of rows. */
    }
    <div
      class="sticky top-[6.25rem] z-20 -my-2 grid gap-1.5 bg-background py-3 md:top-14"
    >
      <label class="sr-only" for="docs-configuration-filter">
        Filter configuration properties
      </label>
      <input
        id="docs-configuration-filter"
        type="search"
        placeholder="Filter properties, e.g. micronaut.server"
        autocomplete="off"
        data-docs-configuration-filter
        class="h-10 w-full max-w-xl rounded-md border bg-background px-3 text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50"
      />
      <p
        class="text-sm text-muted-foreground"
        data-docs-configuration-count
        data-docs-configuration-total={propertyCount}
        data-docs-configuration-noun={groupNoun}
      >
        {countLabel}
      </p>
    </div>
    {
      groups.map((group) => (
        <section
          class="min-w-0 scroll-mt-24"
          id={group.id}
          data-docs-configuration-module
        >
          <h2 class="mb-2 text-xl font-semibold tracking-tight">
            {group.headingHref ? (
              <a href={group.headingHref} class="no-underline hover:underline">
                {group.heading}
              </a>
            ) : (
              group.heading
            )}
          </h2>
          <div class="grid gap-4">
            {/* A grid item defaults to `min-width: auto`, so without `min-w-0`
                the widest property table stretched its cell past the track and
                painted over the module rail. */}
            {group.tables.map((table) => (
              <div
                class="min-w-0 scroll-mt-24"
                id={table.id}
                data-docs-configuration-table
              >
                {table.owner && (
                  <p class="mb-1.5 text-sm text-muted-foreground">
                    Configuration properties for{" "}
                    {table.ownerHref ? (
                      <a
                        href={table.ownerHref}
                        target="_blank"
                        rel="noreferrer"
                        class="text-brand no-underline hover:underline"
                      >
                        <code class="text-[0.85em]">{table.owner}</code>
                      </a>
                    ) : (
                      <code class="text-[0.85em]">{table.owner}</code>
                    )}
                  </p>
                )}
                <div class="overflow-x-auto rounded-lg border">
                  <table class="w-full border-collapse text-sm">
                    <thead>
                      <tr class="border-b bg-muted/50 text-left">
                        <th class="px-3 py-2 font-medium">Property</th>
                        <th class="px-3 py-2 font-medium">Type</th>
                        <th class="px-3 py-2 font-medium">Description</th>
                        {table.rows.some((row) => row.defaultValue) && (
                          <th class="px-3 py-2 font-medium">Default</th>
                        )}
                      </tr>
                    </thead>
                    <tbody>
                      {table.rows.map((row) => (
                        <tr
                          class="border-b align-top last:border-b-0 odd:bg-muted/20 hover:bg-muted/40"
                          data-terms={[
                            row.property,
                            row.type,
                            row.description,
                            row.defaultValue,
                            group.heading,
                          ]
                            .filter(Boolean)
                            .join(" ")
                            .toLowerCase()}
                        >
                          <td class="px-3 py-2">
                            <code class="rounded bg-muted px-1.5 py-0.5 text-[0.8rem] whitespace-nowrap">
                              {row.property}
                            </code>
                          </td>
                          <td class="px-3 py-2 whitespace-nowrap text-muted-foreground">
                            {row.typeHref ? (
                              <a
                                href={row.typeHref}
                                target="_blank"
                                rel="noreferrer"
                                class="text-muted-foreground underline decoration-muted-foreground/40 hover:text-foreground"
                              >
                                {row.type}
                              </a>
                            ) : (
                              row.type
                            )}
                          </td>
                          <td class="w-full px-3 py-2 text-muted-foreground">
                            {row.description}
                          </td>
                          {table.rows.some((other) => other.defaultValue) && (
                            <td class="px-3 py-2 text-muted-foreground">
                              <code class="text-[0.8rem]">
                                {row.defaultValue}
                              </code>
                            </td>
                          )}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }
    <p
      class="text-sm text-muted-foreground"
      data-docs-configuration-empty
      hidden
    >
      No properties match this filter.
    </p>
  </div>
  <aside class="hidden min-w-0 xl:block" aria-label={railLabel}>
    <nav
      class="sticky top-[calc(var(--topbar-height)+24px)] grid max-h-[calc(100vh-var(--topbar-height)-48px)] gap-1.5 overflow-y-auto pb-7 pl-2.5 text-[0.82rem] [scrollbar-width:thin]"
    >
      <h2 class="font-medium">{railLabel}</h2>
      <Separator className="opacity-70" />
      {
        groups.map((group) => (
          <a
            href={`#${group.id}`}
            data-docs-configuration-module-link
            class="flex items-baseline justify-between gap-2 rounded-md px-2 py-1.5 leading-5 break-words text-muted-foreground no-underline hover:bg-accent hover:text-accent-foreground"
          >
            <span>{group.heading}</span>
            <span class="text-[0.72rem] tabular-nums opacity-70">
              {groupCount(group)}
            </span>
          </a>
        ))
      }
    </nav>
  </aside>
</article>

<script>
  import "@/scripts/docs-configuration-reference";
</script>
