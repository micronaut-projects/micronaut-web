const footerGroupPositionClasses: Record<string, string> = {
  Planning: "lg:col-start-2 lg:row-start-1",
  Legal: "lg:col-start-3 lg:row-start-1",
  Policies: "lg:col-start-4 lg:row-start-1",
  Support: "lg:col-start-1 lg:row-start-2",
  Security: "lg:col-start-2 lg:row-start-2",
  Learning: "lg:col-start-3 lg:row-start-2",
  "RSS Feeds": "lg:col-start-4 lg:row-start-2",
};
---

<footer class="border-t bg-muted/35">
  <div
    class="mx-auto grid max-w-[var(--page-max)] gap-10 px-5 py-12 sm:px-6 lg:grid-cols-[minmax(0,1fr)_2.2fr] lg:py-14 xl:px-0"
  >
    <div
      class="grid gap-2 rounded-xl border bg-card p-3 shadow-sm shadow-black/[0.02] sm:grid-cols-3 lg:col-span-2"
    >
      {
        footerPaths.map((path) => (
          <a
            href={withBasePath(path.href)}
            class="group flex items-center justify-center gap-3 rounded-lg p-1.5 no-underline outline-none transition hover:bg-accent/60 focus-visible:ring-[3px] focus-visible:ring-ring/50"
          >
            <span class="grid size-9 place-items-center rounded-md bg-brand-soft text-brand transition group-hover:bg-brand group-hover:text-brand-foreground">
              <IconGlyph name={path.icon} className="size-4" />
            </span>
            <span class="min-w-0 text-left">
              <span class="block text-sm font-semibold leading-5 text-foreground">
                {path.label}
              </span>
              <span class="mt-0.5 block text-xs leading-5 text-muted-foreground">
                {path.description}
              </span>
            </span>
          </a>
        ))
      }
    </div>
    <nav
      class="grid gap-8 sm:grid-cols-2 lg:col-span-2 lg:grid-cols-4"
      aria-label="Main site footer"
    >
      {
        mainSiteFooterGroups.map((group) => (
          <div class={footerGroupPositionClasses[group.title]}>
            <h2 class="text-sm font-semibold text-foreground">{group.title}</h2>
            <ul class="mt-4 grid gap-2.5 leading-7">
              {group.links.map((link) => (
                <li>
                  <a
                    class="text-[0.86rem] text-muted-foreground transition-colors hover:text-foreground hover:underline focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                    href={withBasePath(link.href)}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <Separator className="lg:col-span-2" />
    <div
      class="flex flex-wrap items-center gap-x-5 gap-y-3 text-xs leading-6 text-muted-foreground lg:col-span-2"
    >
      <a
        href={withBasePath("/")}
        class="inline-flex items-center rounded-sm outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
        aria-label="Micronaut home"
      >
        <MicronautLogo className="h-8 w-auto" />
      </a>
      <p>is a project of the</p>
      <a
        href="https://www.commonhaus.org/"
        aria-label="Commonhaus Foundation"
        class="inline-flex rounded-sm outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
      >
        <img
          src={withBasePath(
            "/micronaut-assets/logos/commonhaus-foundation-horizontal.svg",
          )}
          alt="Commonhaus Foundation"
          width="1350"
          height="286"
          class="h-8 w-auto dark:hidden"
        />
        <img
          src={withBasePath(
            "/micronaut-assets/logos/commonhaus-foundation-horizontal-reverse.svg",
          )}
          alt=""
          aria-hidden="true"
          width="800"
          height="350"
          class="hidden h-8 w-auto dark:block"
        />
      </a>
      <nav
        class="ml-auto flex items-center gap-4"
        aria-label="Micronaut social links"
      >
        {
          socialLinks.map((link) => (
            <a
              class="rounded-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
              href={link.href}
              aria-label={link.label}
            >
              <svg
                class="size-5"
                viewBox="0 0 24 24"
                aria-hidden="true"
                fill="currentColor"
              >
                <path d={link.iconPath} />
              </svg>
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
