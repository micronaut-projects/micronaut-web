---
import { ArrowLeftIcon, SearchIcon } from "lucide-react";

import { Button, buttonVariants } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import GuideListRow from "@/components/web/guide-list-row.astro";
import LatestGuideCard from "@/components/web/latest-guide-card.astro";
import { GuideVariantPreferencePicker } from "@/components/web/guide-variant-preference";
import {
  guideCategoryPath,
  latestGuides,
  legacyCategoryAnchor,
  tagSlug,
  type GeneratedGuide,
} from "@/lib/generated-guides";
import { withBasePath } from "@/lib/base-path";

type Props = {
  guides: GeneratedGuide[];
  activeTag?: string;
  root?: string;
};

type SortMode = "latest" | "title";

const { guides, activeTag, root = "/guides" } = Astro.props;
const rootPath = `${root.replace(/\/+$/, "")}/`;
const searchParams = Astro.url.searchParams;
const query = (searchParams.get("q") || "").trim();
const selectedCategory = (searchParams.get("category") || "").trim();
const selectedTag = activeTag || (searchParams.get("tag") || "").trim();
const sortParam = (searchParams.get("sort") || "latest").trim();
const sortMode: SortMode = sortParam === "title" ? sortParam : "latest";
const selectedLanguage = (searchParams.get("language") || "").trim();
const categorySlug = tagSlug;
const visibleGuides = sortGuides(
  guides.filter(
    (guide) =>
      matchesQuery(guide, query) &&
      matchesCategory(guide, selectedCategory) &&
      matchesTag(guide, selectedTag) &&
      matchesLanguage(guide, selectedLanguage),
  ),
  sortMode,
);
// Only a guide whose metadata opted into a Pyronaut variant renders one, so
// the catalog offers the Python filter only where such guides exist: on a
// guides repository without them the control would filter to nothing.
const pythonGuideCount = guides.filter((guide) =>
  guideLanguages(guide).includes("python"),
).length;
// The index used to list 54 category sections in latest-guide order, with
// Getting Started last and no way to jump between them. With ~230 guides the
// catalog is too large to list outright, so the default view is a category
// directory split into the ordered learning path and the topical rest;
// picking a category shows its guides as compact rows, and a text query
// renders one flat latest-first result list. Everything is prerendered:
// `?category=` and `?q=` are applied by the client filter script.
const CATEGORY_ORDER = [
  "Getting Started",
  "Core Basics",
  "HTTP Server",
  "HTTP Client",
  "Development",
  "Testing",
  "Data Access",
  "Data JDBC",
  "Data JPA",
  "Data R2DBC",
  "GraalVM",
  "Serverless",
  "AWS Lambda",
  "Kubernetes",
];
const categoryRank = new Map(
  CATEGORY_ORDER.map((category, index) => [category, index]),
);
const categoryGroups = new Map<string, GeneratedGuide[]>();
for (const guide of visibleGuides) {
  const category = guide.categories[0] || "Guides";
  categoryGroups.set(category, [
    ...(categoryGroups.get(category) || []),
    guide,
  ]);
}
const orderedCategoryGroups = [...categoryGroups.entries()].sort(
  ([left], [right]) => {
    const leftRank = categoryRank.get(left) ?? Number.MAX_SAFE_INTEGER;
    const rightRank = categoryRank.get(right) ?? Number.MAX_SAFE_INTEGER;
    return leftRank - rightRank || left.localeCompare(right);
  },
);
const rankedCategoryGroups = orderedCategoryGroups.filter(([category]) =>
  categoryRank.has(category),
);
const otherCategoryGroups = orderedCategoryGroups.filter(
  ([category]) => !categoryRank.has(category),
);
const hasFilters = Boolean(
  query ||
  selectedCategory ||
  selectedTag ||
  selectedLanguage ||
  sortMode !== "latest",
);
const recentGuides = hasFilters ? [] : latestGuides(visibleGuides, 3);

function categoryHref(category: string) {
  return withBasePath(guideCategoryPath(category, root));
}

function guideCount(count: number) {
  return `${count} ${count === 1 ? "guide" : "guides"}`;
}

function matchesCategory(guide: GeneratedGuide, category: string) {
  if (!category) {
    return true;
  }
  return guide.categories.some(
    (guideCategory) =>
      guideCategory === category || categorySlug(guideCategory) === category,
  );
}

function matchesTag(guide: GeneratedGuide, tag: string) {
  if (!tag) {
    return true;
  }
  return guide.tags.includes(tag);
}

function guideLanguages(guide: GeneratedGuide) {
  return [...new Set(guide.options.map((option) => option.language))];
}

function matchesLanguage(guide: GeneratedGuide, language: string) {
  if (!language) {
    return true;
  }
  return guideLanguages(guide).includes(language);
}

function matchesQuery(guide: GeneratedGuide, value: string) {
  if (!value) {
    return true;
  }
  const normalized = value.toLowerCase();
  const normalizedSlug = categorySlug(value);
  const searchableText = [
    guide.slug,
    guide.title,
    guide.intro,
    guide.authors.join(" "),
    guide.categories.join(" "),
    guide.tags.join(" "),
  ]
    .join(" ")
    .toLowerCase();
  const searchableSlugs = [
    guide.slug,
    ...guide.categories.map(categorySlug),
    ...guide.tags.map(categorySlug),
  ].join(" ");
  return (
    searchableText.includes(normalized) ||
    Boolean(normalizedSlug && searchableSlugs.includes(normalizedSlug))
  );
}

function sortGuides(items: GeneratedGuide[], mode: SortMode) {
  return [...items].sort((left, right) => {
    if (mode === "title") {
      return left.title.localeCompare(right.title);
    }
    return (
      right.publicationDate.localeCompare(left.publicationDate) ||
      left.title.localeCompare(right.title)
    );
  });
}
---

<main
  class="mx-auto grid w-full max-w-[var(--page-max)] gap-10 px-4 py-8 sm:px-6 lg:py-10 xl:px-0"
  data-guides-catalog
  data-active-tag={activeTag || ""}
>
  <header>
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight md:text-5xl">
      {activeTag ? `Micronaut Guides: ${activeTag}` : "Micronaut Guides"}
    </h1>
    {
      /* This is the catalog filter, not a second site search: it narrows the
         guides below as you type, while the header dialog searches the docs. */
    }
    <div
      class="mt-6 grid gap-3 lg:grid-cols-[auto_minmax(0,1fr)] lg:items-center"
    >
      <GuideVariantPreferencePicker client:load />
      {
        pythonGuideCount > 0 && (
          <a
            href={withBasePath(`${rootPath}?language=python`)}
            data-guides-language-filter="python"
            aria-pressed="false"
            class:list={[
              buttonVariants({ variant: "outline", size: "sm" }),
              "no-underline aria-pressed:border-transparent aria-pressed:bg-primary aria-pressed:text-primary-foreground",
            ]}
          >
            Python only
            <span class="text-xs tabular-nums opacity-70">
              {pythonGuideCount}
            </span>
          </a>
        )
      }
      <form
        method="get"
        class="flex w-full min-w-0 gap-2 lg:col-start-2 lg:row-start-1 lg:max-w-[32rem] lg:justify-self-end"
        role="search"
      >
        {
          selectedCategory && (
            <input type="hidden" name="category" value={selectedCategory} />
          )
        }
        {selectedTag && <input type="hidden" name="tag" value={selectedTag} />}
        {
          selectedLanguage && (
            <input type="hidden" name="language" value={selectedLanguage} />
          )
        }
        {
          sortMode !== "latest" && (
            <input type="hidden" name="sort" value={sortMode} />
          )
        }
        <label class="sr-only" for="guides-search">Filter guides</label>
        <div class="relative min-w-0 flex-1">
          <SearchIcon
            className="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted-foreground"
            aria-hidden="true"
          />
          <Input
            id="guides-search"
            name="q"
            type="search"
            defaultValue={query}
            placeholder={`Filter ${guides.length} guides…`}
            autoComplete="off"
            className="h-11 pl-9"
          />
        </div>
        <Button type="submit" variant="outline" className="h-11">Filter</Button>
      </form>
    </div>
  </header>

  {
    !activeTag && recentGuides.length > 0 && (
      <section class="grid gap-4" data-guides-latest-section>
        <h2 class="text-2xl font-semibold tracking-tight">Latest Guides</h2>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {recentGuides.map((guide) => (
            <LatestGuideCard guide={guide} root={root} />
          ))}
        </div>
      </section>
    )
  }

  <section class="grid gap-4" data-guides-search-results hidden>
    <div class="flex items-baseline gap-3">
      <h2 class="text-2xl font-semibold tracking-tight">Search Results</h2>
      <span
        class="text-sm text-muted-foreground tabular-nums"
        data-guides-search-count></span>
    </div>
    <div class="divide-y divide-border" data-guides-search-list></div>
  </section>

  {
    !hasFilters && (
      <section class="grid gap-10" data-guides-directory>
        <div class="grid gap-5">
          <h2 class="text-2xl font-semibold tracking-tight">Learning Path</h2>
          <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            {rankedCategoryGroups.map(([category, categoryGuides], index) => (
              <a
                href={categoryHref(category)}
                class="group flex items-center gap-4 rounded-lg border px-4 py-3.5 no-underline transition-colors hover:border-brand/50 hover:bg-accent"
              >
                <span class="text-sm font-semibold text-muted-foreground/60 tabular-nums transition-colors group-hover:text-brand">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="min-w-0">
                  <span class="block truncate font-medium">{category}</span>
                  <span class="block text-xs text-muted-foreground">
                    {guideCount(categoryGuides.length)}
                  </span>
                </span>
              </a>
            ))}
          </div>
        </div>
        {otherCategoryGroups.length > 0 && (
          <div class="grid gap-5">
            <h2 class="text-2xl font-semibold tracking-tight">All Topics</h2>
            <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
              {otherCategoryGroups.map(([category, categoryGuides]) => (
                <a
                  href={categoryHref(category)}
                  class="flex items-center justify-between gap-3 rounded-lg border px-4 py-3 no-underline transition-colors hover:border-brand/50 hover:bg-accent"
                >
                  <span class="min-w-0 truncate font-medium">{category}</span>
                  <span class="shrink-0 text-sm text-muted-foreground tabular-nums">
                    {categoryGuides.length}
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}
      </section>
    )
  }

  <div
    class="grid gap-8 lg:grid-cols-[13rem_minmax(0,1fr)] lg:items-start"
    data-guides-results
    hidden={!hasFilters}
  >
    <nav
      class="sticky top-20 hidden max-h-[calc(100vh-6rem)] overflow-y-auto pr-2 lg:block"
      aria-label="Guide categories"
    >
      <p
        class="text-xs font-medium tracking-wide text-muted-foreground uppercase"
      >
        Categories
      </p>
      <ul class="mt-3 grid gap-0.5 text-sm">
        {
          orderedCategoryGroups.map(([category, categoryGuides]) => (
            <li>
              <a
                href={categoryHref(category)}
                class="flex items-baseline justify-between gap-2 rounded-md px-2 py-1 text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-foreground aria-[current=true]:bg-accent aria-[current=true]:font-medium aria-[current=true]:text-foreground"
                data-guide-category-jump-link
                data-category={categorySlug(category)}
              >
                <span>{category}</span>
                <span class="text-xs text-muted-foreground/70 tabular-nums">
                  {categoryGuides.length}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="grid min-w-0 gap-6">
      <a
        href={withBasePath(rootPath)}
        class="inline-flex items-center gap-1.5 justify-self-start text-sm text-muted-foreground no-underline transition-colors hover:text-foreground"
      >
        <ArrowLeftIcon className="size-4" aria-hidden="true" />
        All categories
      </a>
      <details
        class="rounded-lg border px-4 py-3 lg:hidden"
        data-guide-category-jump
      >
        <summary class="cursor-pointer text-sm font-medium">Categories</summary>
        <nav aria-label="Guide categories">
          <ul class="mt-3 grid gap-0.5 text-sm">
            {
              orderedCategoryGroups.map(([category, categoryGuides]) => (
                <li>
                  <a
                    href={categoryHref(category)}
                    class="flex items-baseline justify-between gap-2 rounded-md px-2 py-1 text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-foreground aria-[current=true]:bg-accent aria-[current=true]:font-medium aria-[current=true]:text-foreground"
                    data-guide-category-jump-link
                    data-category={categorySlug(category)}
                  >
                    <span>{category}</span>
                    <span class="text-xs text-muted-foreground/70 tabular-nums">
                      {categoryGuides.length}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
      <section id="guides-list" class="grid gap-9">
        {
          orderedCategoryGroups.map(([category, categoryGuides]) => (
            <section
              class="scroll-mt-24"
              id={`category-${categorySlug(category)}`}
              data-guide-category-group
            >
              {/* The id the legacy guides index used for this section, kept so
              old deep links still land on it. */}
              {legacyCategoryAnchor(category) && (
                <span
                  id={legacyCategoryAnchor(category)}
                  class="block scroll-mt-24"
                  aria-hidden="true"
                />
              )}
              <div class="flex items-baseline gap-2 border-b pb-3">
                <h2 class="text-xl font-semibold tracking-tight">{category}</h2>
                <span class="text-sm text-muted-foreground tabular-nums">
                  {categoryGuides.length}
                </span>
              </div>
              <div class="divide-y divide-border" data-guide-card-grid>
                {categoryGuides.map((guide) => (
                  <div
                    data-guide-card
                    data-title={guide.title}
                    data-search={[
                      guide.slug,
                      guide.title,
                      guide.intro,
                      guide.authors.join(" "),
                      guide.categories.join(" "),
                      guide.tags.join(" "),
                      guide.categories.map(categorySlug).join(" "),
                      guide.tags.map(categorySlug).join(" "),
                    ]
                      .join(" ")
                      .toLowerCase()}
                    data-categories={guide.categories
                      .map(categorySlug)
                      .join("|")}
                    data-tags={guide.tags.map(categorySlug).join("|")}
                    data-languages={guideLanguages(guide).join("|")}
                    data-date={guide.publicationDate}
                  >
                    <GuideListRow guide={guide} root={root} />
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </section>
    </div>
  </div>

  <div data-guides-empty hidden={visibleGuides.length > 0}>
    <Card>
      <CardHeader>
        <CardTitle>No guides found</CardTitle>
        <CardDescription
          >Nothing matches this filter. Try a different term, or browse the
          catalog by category.</CardDescription
        >
      </CardHeader>
      <CardContent>
        <a
          href={withBasePath(`${root}/`)}
          class:list={[buttonVariants(), "no-underline"]}
        >
          Browse all categories
        </a>
      </CardContent>
    </Card>
  </div>
</main>

<script>
  import "@/scripts/guides-catalog-filters";
</script>
