---
import { buttonVariants } from "@/components/ui/button";

interface Props {
  version?: string;
  links: { label: string; href: string; external: boolean }[];
  /** Stacked in the section rail rather than laid out as the top row. */
  stacked?: boolean;
}

const { version, links, stacked = false } = Astro.props;
---

<div
  class:list={[
    "flex gap-2",
    stacked
      ? "flex-col items-stretch"
      : "flex-wrap items-center sm:group-data-[stuck=true]/references:fixed sm:group-data-[stuck=true]/references:right-4 sm:group-data-[stuck=true]/references:bottom-4 sm:group-data-[stuck=true]/references:z-30",
  ]}
>
  {
    version && (
      <span
        data-docs-project-version
        class:list={[
          "rounded-md border bg-background px-2.5 py-1 text-xs font-medium text-muted-foreground",
          stacked
            ? "self-start"
            : "mr-auto transition-shadow duration-300 ease-out group-data-[stuck=true]/references:shadow-md sm:group-data-[stuck=true]/references:mr-0",
        ]}
      >
        {version}
      </span>
    )
  }
  <nav
    aria-label="Reference documentation"
    class:list={[
      "flex gap-2",
      stacked ? "flex-col" : "flex-wrap sm:justify-end",
    ]}
  >
    {
      links.map((reference) => (
        <a
          href={reference.href}
          target={reference.external ? "_blank" : undefined}
          rel={reference.external ? "noreferrer" : undefined}
          class:list={[
            buttonVariants({ size: "sm", variant: "outline" }),
            stacked
              ? "justify-start"
              : "transition-shadow duration-300 ease-out group-data-[stuck=true]/references:shadow-md",
          ]}
        >
          {reference.label}
        </a>
      ))
    }
  </nav>
</div>
