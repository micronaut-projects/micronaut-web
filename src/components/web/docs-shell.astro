---
import { buttonVariants } from "@/components/ui/button";
import DocsSidebarContent from "@/components/web/docs-sidebar-content.astro";
import DocsScrollSpy from "@/components/web/docs-scroll-spy.astro";
import { ArrowUp } from "lucide-react";
import type { DocsProjectCatalog } from "@/lib/content-catalog";

type ActiveSection = {
  id: string;
  label: string;
};

/** A subsection of one chapter, for the docs bar's section menu. */
type CurrentSection = ActiveSection & {
  indent: number;
  parentId?: string;
};

interface Props {
  projectCatalog: DocsProjectCatalog;
  activeSlug?: string;
  activeSections?: ActiveSection[];
  currentSections?: CurrentSection[];
  /** The chapter the page opens in, before the reader scrolls anywhere. */
  initialRootId?: string;
}

const {
  projectCatalog,
  activeSlug,
  activeSections = [],
  currentSections = [],
  initialRootId,
} = Astro.props;
const initialSectionLabel = activeSections.find(
  (section) => section.id === initialRootId,
)?.label;
const sectionMenuHidden =
  !initialRootId ||
  currentSections.every((section) => section.parentId !== initialRootId);
---

<div id="docs-top" data-docs-shell class="min-h-[calc(100svh-3.5rem)]">
  <div class="flex min-h-0 flex-1">
    <aside
      data-docs-sidebar
      data-state="expanded"
      data-collapsible=""
      data-variant="sidebar"
      data-side="left"
      data-slot="sidebar"
      class="group peer hidden text-sidebar-foreground md:block"
    >
      <div
        data-slot="sidebar-gap"
        class="relative w-[248px] bg-transparent transition-[width] duration-200 ease-linear group-data-[collapsible=icon]:w-14"
      >
      </div>
      <div
        data-slot="sidebar-container"
        class="fixed inset-y-0 bottom-auto left-0 top-14 z-10 hidden h-[calc(100svh-3.5rem)] w-[248px] transition-[left,right,width] duration-200 ease-linear md:flex group-data-[collapsible=icon]:w-14 group-data-[side=left]:border-r group-data-[side=right]:border-l"
      >
        <div
          data-sidebar="sidebar"
          data-slot="sidebar-inner"
          class="flex h-full w-full flex-col bg-sidebar"
        >
          <DocsSidebarContent
            projectCatalog={projectCatalog}
            activeSlug={activeSlug}
            activeSections={activeSections}
            instanceId="desktop"
          />
          <button
            type="button"
            class="docs-sidebar-rail-control"
            data-docs-sidebar-toggle
            aria-label="Toggle Sidebar"
            aria-expanded="true"
            title="Toggle Sidebar"
          >
            <span class="sr-only">Toggle Sidebar</span>
          </button>
        </div>
      </div>
    </aside>
    <main
      data-slot="sidebar-inset"
      class="relative flex w-full min-w-0 flex-1 flex-col bg-background"
    >
      <div
        class="sticky top-14 z-30 flex h-11 items-center border-b bg-background/95 px-4 backdrop-blur md:hidden"
      >
        {
          /* Labelled: this sits directly under the site's own hamburger, and
            two bare icons gave no clue which one opened the docs navigation.
            "Docs", because the drawer holds the whole docs catalog, not just
            this page's chapters. */
        }
        <button
          type="button"
          class="inline-flex h-8 items-center gap-1.5 rounded-md px-2 text-xs font-medium hover:bg-accent focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
          data-docs-mobile-nav-trigger
          aria-label="Open docs navigation"
        >
          <span aria-hidden="true">☰</span>
          Docs
        </button>
        <dialog
          class="m-0 h-full w-[calc(100vw-1rem)] max-w-sm border-0 bg-sidebar p-0 text-sidebar-foreground shadow-xl backdrop:bg-black/50"
          data-docs-mobile-nav
          aria-label="Docs navigation"
        >
          <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-semibold">Docs navigation</span>
            <button
              type="button"
              data-docs-mobile-nav-close
              aria-label="Close docs navigation">×</button
            >
          </div>
          <div class="docs-sidebar-mobile-sheet-body">
            <DocsSidebarContent
              projectCatalog={projectCatalog}
              activeSlug={activeSlug}
              activeSections={activeSections}
              instanceId="mobile"
            />
          </div>
        </dialog>
        {
          /* The side rail that lists a chapter's subsections is xl-only, so on
            a phone the only way through a chapter was to scroll it. This is
            that rail: the chapter the reader is in, named in the bar and kept
            current by the scroll spy, opening the jump list for it. */
          currentSections.length > 0 && (
            <details
              class="relative ml-auto min-w-0"
              data-docs-section-menu
              hidden={sectionMenuHidden}
            >
              <summary class="flex h-8 max-w-[62vw] cursor-pointer list-none items-center gap-1.5 [&::-webkit-details-marker]:hidden rounded-md px-2 text-xs text-muted-foreground hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50">
                <span class="truncate" data-docs-current-section-label>
                  {initialSectionLabel}
                </span>
                <span aria-hidden="true">▾</span>
              </summary>
              <nav
                class="absolute right-0 top-full z-40 mt-1 grid max-h-[60svh] w-[min(22rem,calc(100vw-2rem))] gap-0.5 overflow-y-auto rounded-md border bg-background p-1.5 text-sm shadow-lg [scrollbar-width:thin]"
                aria-label="In this section"
                data-docs-scroll-container
              >
                {currentSections.map((section) => (
                  <a
                    href={`#${section.id}`}
                    data-docs-current-section-link
                    data-docs-scroll-link
                    data-docs-section-root-id={section.parentId}
                    hidden={section.parentId !== initialRootId}
                    class:list={[
                      "rounded-md py-1.5 pr-2 leading-5 break-words text-muted-foreground no-underline hover:bg-accent hover:text-accent-foreground data-[active=true]:bg-accent data-[active=true]:font-medium data-[active=true]:text-foreground [&.active]:bg-accent [&.active]:font-medium [&.active]:text-foreground",
                      section.indent <= 2 && "pl-2",
                      section.indent === 3 && "pl-4",
                      section.indent >= 4 && "pl-6",
                    ]}
                  >
                    {section.label}
                  </a>
                ))}
              </nav>
            </details>
          )
        }
      </div>
      <slot />
      <a
        href="#docs-top"
        class={buttonVariants({
          variant: "outline",
          size: "icon",
          className:
            "group fixed right-4 bottom-6 z-40 translate-y-2 border bg-background/95 opacity-0 shadow-md backdrop-blur transition-[transform,box-shadow,background-color,color,opacity] duration-200 pointer-events-none hover:bg-accent hover:text-accent-foreground data-[state=visible]:pointer-events-auto data-[state=visible]:translate-y-0 data-[state=visible]:opacity-100 active:scale-95 active:translate-y-0.5 active:shadow-sm md:right-8",
        })}
        aria-label="Back to top"
        aria-hidden="true"
        title="Back to top"
        data-docs-page-top
        data-state="hidden"
        tabIndex={-1}
      >
        <ArrowUp
          className="size-4 transition-transform duration-200 group-active:-translate-y-0.5"
          aria-hidden="true"
        />
      </a>
    </main>
  </div>
  <DocsScrollSpy />
</div>

<script>
  import "@/scripts/docs-sidebar-controls";
</script>
