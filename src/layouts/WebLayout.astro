---
import "@/styles/globals.css";
import { SiteHeader } from "@/components/web/site-header";
import {
  LEGACY_THEME_STORAGE_KEY,
  THEME_MODE_COOKIE_NAME,
  THEME_MODE_QUERY_PARAMETER,
  THEME_MODE_STORAGE_KEY,
} from "@/lib/experience-theme";
import { getMainSitePageSummaries } from "@/lib/main-site-content";
import { withBasePath, withSurfacePath } from "@/lib/base-path";
import {
  canonicalSurfaceUrl,
  deploySurface,
  externalSurfacePath,
  externalSurfaceUrls,
  googleAnalyticsId,
} from "@/lib/deployment-config";
import { googleAnalyticsTagHtml } from "@/lib/google-analytics";
import { SITE_DESCRIPTION, SITE_NAME } from "@/lib/site-identity";

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  surface?: "main" | "docs" | "guides";
  hideHeader?: boolean;
  /** Social card type; articles also carry their publication date. */
  pageType?: "website" | "article";
  publishedTime?: string;
  /** Keeps a page out of search results and out of the sitemap. */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  canonicalUrl,
  surface = "main",
  hideHeader = false,
  pageType = "website",
  publishedTime,
  noindex = false,
} = Astro.props;
// Development shares the canonical deployment configuration, so the tag is
// withheld there too rather than reporting every local page view.
const googleAnalyticsHtml =
  import.meta.env.DEV || !googleAnalyticsId
    ? ""
    : googleAnalyticsTagHtml(googleAnalyticsId);
const canonicalSurface = surface;
const basePath = import.meta.env.BASE_URL || "/";
const routePath =
  basePath !== "/" && Astro.url.pathname.startsWith(basePath)
    ? `/${Astro.url.pathname.slice(basePath.length)}`
    : Astro.url.pathname;
const resolvedCanonicalUrl =
  canonicalUrl || canonicalSurfaceUrl(canonicalSurface, routePath);
const shouldUseRemoteHeader =
  !import.meta.env.DEV &&
  (deploySurface === "docs" || deploySurface === "guides") &&
  (surface === "docs" || surface === "guides");
const mainSitePages = shouldUseRemoteHeader
  ? []
  : await getMainSitePageSummaries();
const remoteHeaderScriptUrl = new URL(
  "shell/site-header.js",
  externalSurfaceUrls.main,
).toString();
const remoteHeaderStyleUrl = new URL(
  "shell/site-header.css",
  externalSurfaceUrls.main,
).toString();
// Read from the docs root this deployment actually serves. The standalone
// docs root is `/latest`, which carries only redirect stubs for the HTML
// pages of the current line — no `search-index.json` — so resolving it that
// way made every docs query answer "No results found".
const docsSearchIndexUrl = withSurfacePath("docs", "/docs/search-index.json");
// The route only survives pruning on the main artifact, so the guides surface
// reads it cross-origin the way docs search already reads its own index.
const siteSearchIndexUrl = withSurfacePath("main", "/search-index.json");
// That index carries no guides: the main artifact is built without generated
// guide content, so search reads the guide list from the guides deployment,
// the surface that actually renders every published guide.
const guidesManifestUrl = withSurfacePath("guides", "/guides/manifest.json");
const siteHeaderFrameClass = "sticky top-0 z-40";
// Share assets live on the main site so every surface points at one copy.
const shareImageUrl = externalSurfacePath(
  "main",
  "/micronaut-assets/social/micronaut-share-card.png",
);
const structuredData = {
  "@context": "https://schema.org",
  "@type": pageType === "article" ? "BlogPosting" : "WebPage",
  ...(pageType === "article" ? { headline: title } : { name: title }),
  description,
  url: resolvedCanonicalUrl,
  image: shareImageUrl,
  inLanguage: "en",
  ...(publishedTime ? { datePublished: publishedTime } : {}),
  isPartOf: {
    "@type": "WebSite",
    name: SITE_NAME,
    url: externalSurfaceUrls.main,
  },
  publisher: {
    "@type": "Organization",
    name: SITE_NAME,
    url: externalSurfaceUrls.main,
    logo: externalSurfacePath(
      "main",
      "/micronaut-assets/logos/micronaut-horizontal-black.svg",
    ),
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={resolvedCanonicalUrl} />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={SITE_NAME} />
    {googleAnalyticsHtml && <Fragment set:html={googleAnalyticsHtml} />}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
    <script
      is:inline
      define:vars={{
        legacyThemeStorageKey: LEGACY_THEME_STORAGE_KEY,
        themeModeCookieName: THEME_MODE_COOKIE_NAME,
        themeModeQueryParameter: THEME_MODE_QUERY_PARAMETER,
        themeModeStorageKey: THEME_MODE_STORAGE_KEY,
      }}
    >
      (() => {
        const root = document.documentElement;
        const colorPreference = window.matchMedia(
          "(prefers-color-scheme: dark)",
        );
        const preferredThemeMode = colorPreference.matches ? "dark" : "light";
        const isThemeMode = (value) => value === "light" || value === "dark";
        const resolveDark = (mode) => mode === "dark";
        const applyThemeMode = (mode) => {
          const dark = resolveDark(mode);
          root.dataset.themeMode = mode;
          root.classList.toggle("dark", dark);
          root.style.colorScheme = dark ? "dark" : "light";
        };
        // The parent-domain cookie carries the choice across micronaut.io,
        // docs.micronaut.io, and guides.micronaut.io; localStorage is per
        // origin and stays as the fallback where the cookie cannot be set.
        const persistThemeMode = (mode) => {
          localStorage.setItem(themeModeStorageKey, mode);
          localStorage.removeItem(legacyThemeStorageKey);
          const labels = window.location.hostname.split(".");
          const domain =
            labels.length > 1 && !/^\d+$/.test(labels[labels.length - 1])
              ? `; domain=.${labels.slice(-2).join(".")}`
              : "";
          document.cookie = `${themeModeCookieName}=${mode}; path=/; max-age=31536000; SameSite=Lax${domain}`;
        };
        let themeMode = preferredThemeMode;
        try {
          const presetMode = new URLSearchParams(window.location.search).get(
            themeModeQueryParameter,
          );
          const cookieMode = (document.cookie.match(
            new RegExp(`(?:^|;\\s*)${themeModeCookieName}=(light|dark)`),
          ) || [])[1];
          const storedMode = localStorage.getItem(themeModeStorageKey);
          const legacyMode = localStorage.getItem(legacyThemeStorageKey);
          if (isThemeMode(presetMode)) {
            themeMode = presetMode;
            persistThemeMode(presetMode);
          } else if (isThemeMode(cookieMode)) {
            themeMode = cookieMode;
          } else if (isThemeMode(storedMode)) {
            themeMode = storedMode;
            persistThemeMode(storedMode);
          } else if (legacyMode === "light" || legacyMode === "dark") {
            themeMode = legacyMode;
            persistThemeMode(legacyMode);
          }
        } catch {
          themeMode = preferredThemeMode;
        }
        applyThemeMode(themeMode);
      })();
    </script>
    <script is:inline>
      (() => {
        const cookies = document.cookie.split(";").map((value) => value.trim());
        const langCookie = cookies.find((value) =>
          value.startsWith("micronaut-code-language="),
        );
        const buildCookie = cookies.find((value) =>
          value.startsWith("micronaut-build-tool="),
        );
        const language = langCookie?.slice("micronaut-code-language=".length);
        const buildTool = buildCookie?.slice("micronaut-build-tool=".length);
        if (
          language === "kotlin" ||
          language === "groovy" ||
          buildTool === "maven"
        ) {
          document.documentElement.dataset.codeLanguagePending = "true";
        }
      })();
    </script>
    <link
      rel="icon"
      href={withBasePath("/micronaut-assets/icons/micronaut-sally.svg")}
    />
    {
      !hideHeader && shouldUseRemoteHeader && (
        <link
          rel="stylesheet"
          href={remoteHeaderStyleUrl}
          data-micronaut-site-header-style
        />
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen bg-background text-foreground">
      {
        !hideHeader && shouldUseRemoteHeader && (
          <>
            <div
              id="micronaut-site-header"
              data-micronaut-site-header
              data-surface={surface}
              data-main-url={externalSurfaceUrls.main}
              data-docs-url={externalSurfaceUrls.docs}
              data-guides-url={externalSurfaceUrls.guides}
              data-docs-search-index-url={docsSearchIndexUrl}
              data-site-search-index-url={siteSearchIndexUrl}
              data-guides-manifest-url={guidesManifestUrl}
              class={siteHeaderFrameClass}
            >
              <SiteHeader
                docsSearchIndexUrl={docsSearchIndexUrl}
                guidesManifestUrl={guidesManifestUrl}
                siteSearchIndexUrl={siteSearchIndexUrl}
                navigationUrls={externalSurfaceUrls}
                surface={surface}
              />
            </div>
            <script type="module" src={remoteHeaderScriptUrl} />
          </>
        )
      }
      {
        !hideHeader && !shouldUseRemoteHeader && (
          <div class={siteHeaderFrameClass}>
            <SiteHeader
              surface={surface}
              guidesManifestUrl={guidesManifestUrl}
              siteSearchIndexUrl={siteSearchIndexUrl}
              isBlogRoute={
                routePath === "/blog" || routePath.startsWith("/blog/")
              }
              isReleasesRoute={routePath === "/category/release-announcements"}
              mainSitePages={mainSitePages}
              client:load
            />
          </div>
        )
      }
      <slot />
    </div>
  </body>
</html>
